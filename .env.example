# SalahKit environment template (S13).
# Copy to .env.local - never commit real values.
# Vite exposes VITE_-prefixed variables to the client bundle.

# Canonical site URL used for canonical links, sitemap and OG tags.
VITE_APP_URL=https://salahkit.app

# Displayed app version (semantic).
VITE_APP_VERSION=1.0.0
